  "assumptions": [
    {
      "id": "A-NORMALIZATION",
      "impose": "division probabilities sum to one and coarse grain additively",
      "drop_control": "one port is amplified while the other ports are unchanged"
    },
    {
      "id": "A-ALL-INPUT-COMPLETENESS",
      "impose": "the division instrument obeys the operator identity for every input",
      "drop_control": "the identity fails away from one calibration state"
    },
    {
      "id": "A-POINTER-READABILITY",
      "impose": "definite pointer labels are permuted reversibly",
      "drop_control": "two pointer labels are merged"
    },
    {
      "id": "A-FULL-ACCUMULATION",
      "impose": "repeated writing visits every pointer label",
      "drop_control": "reversible permutations with more than one cycle are admitted"
    },
    {
      "id": "A-RENAMING-COVARIANCE",
      "impose": "simultaneous pointer relabelings are representation changes",
      "drop_control": "named writer and reader parameters are compared before quotienting"
    },
    {
      "id": "A-SPECTATOR-NATURALITY",
      "impose": "an idle factor leaves the registered law unchanged modulo null directions",
      "drop_control": "a dressed context receives an independent kernel"
    },
    {
      "id": "A-TYPE-UNIVERSALITY",
      "impose": "identified event tokens share one reader rule",
      "drop_control": "token-disjoint contexts carry unrelated reader functions"
    },
    {
      "id": "A-TRANSLATION-COMPOSITION",
      "impose": "incremental record influences obey U(n+m)=U(n)U(m)",
      "drop_control": "general pointer-indexed phase readers remain allowed"
    },
    {
      "id": "A-RECIPROCAL-FEEDBACK",
      "impose": "a matter-controlled write must operationally affect matter",
      "drop_control": "an uncontrolled record shift is permitted"
    },
    {
      "id": "A-PREDICTIVE-MINIMALITY",
      "impose": "families are compared by intervention-complete predictive quotients at equal dimension",
      "drop_control": "a growing raw history label is counted without resource parity"
    },
    {
      "id": "A-DISJOINT-LOCALITY",
      "impose": "complete operations on one fixed factor preserve the remote unconditioned marginal",
      "drop_control": "a trace-amplifying local operation is admitted"
    },
    {
      "id": "A-RECORD-RECOVERABILITY",
      "impose": "the final record partition remains perfectly distinguishable under every licensed continuation",
      "drop_control": "a reset continuation merges the record sectors"
    },
    {
      "id": "A-REFINEMENT-GLUING",
      "impose": "the two-history cross terms cancel when all final record ports are coarse grained",
      "drop_control": "one final port is deleted before coarse graining"
    },
    {
      "id": "A-DIVISION-PLACEMENT",
      "impose": "ordinary probabilities are assigned only at the final stable record partition",
      "drop_control": "unrecorded rewrite alternatives are made exclusive at the intermediate cut"
    }
  ],
